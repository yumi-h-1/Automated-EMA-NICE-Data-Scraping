# Copy to .env and fill in, or export these in your shell before running.
# In Colab, store OPENAI_API_KEY as a notebook secret instead.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Embedding model for the retrieval behind the "What changed" summaries.
# Only read by scripts/rag.py.
EMBEDDING_MODEL=text-embedding-3-small
