{
  "name": "ema-nice-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "Regulatory and HTA tracking for medicines recommended by the EMA's CHMP, cross-referenced against NICE.",
  "type": "module",
  "engines": { "node": ">=20" },
  "workspaces": ["packages/*"],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "crawl": "npm run start --workspace @ema-nice/crawler",
    "cli": "node packages/cli/src/index.js",
    "web": "node packages/web/server.js",
    "test": "npm run test --workspaces --if-present"
  }
}
